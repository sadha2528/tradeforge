datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String            @id @default(uuid())
  email     String            @unique
  name      String?
  createdAt DateTime          @default(now())
  sessions  BacktestSession[]
}

model BacktestSession {
  id              String            @id @default(uuid())
  userId          String?
  name            String
  strategyName    String?
  symbol          String
  timeframe       String
  startDate       Int
  endDate         Int
  startingBalance Float             @default(100000.0)
  currentBalance  Float             @default(100000.0)
  currentEquity   Float             @default(100000.0)
  progressIndex   Int               @default(0)
  status          String            @default("active")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades          TradeRecord[]
  drawings        DrawingRecord[]
  indicators      IndicatorRecord[]
}

model TradeRecord {
  id          String          @id @default(uuid())
  sessionId   String
  symbol      String
  side        String
  entryPrice  Float
  exitPrice   Float?
  entryTime   Int
  exitTime    Int?
  quantity    Float
  stopLoss    Float?
  takeProfit  Float?
  grossPnL    Float           @default(0.0)
  netPnL      Float           @default(0.0)
  rMultiple   Float?
  duration    Int?
  setup       String?
  notes       String?
  emotion     String?
  tags        String?
  session     BacktestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model DrawingRecord {
  id         String          @id @default(uuid())
  sessionId  String
  type       String
  pointsJson String
  color      String
  lineWidth  Int             @default(2)
  text       String?
  visible    Boolean         @default(true)
  session    BacktestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model IndicatorRecord {
  id             String          @id @default(uuid())
  sessionId      String
  type           String
  name           String
  isOverlay      Boolean         @default(true)
  visible        Boolean         @default(true)
  color          String
  lineWidth      Int             @default(2)
  parametersJson String
  session        BacktestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
